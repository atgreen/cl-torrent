(in-package #:cl-torrent)

(define-condition bencode-error (error)
  ((message :initarg :message :reader bencode-error-message))
  (:report (lambda (condition stream)
             (write-string (bencode-error-message condition) stream))))

(defun bencode-fail (control &rest arguments)
  (error 'bencode-error :message (apply #'format nil control arguments)))

(defstruct (bencode-map (:constructor %make-bencode-map (entries))) entries)

(defun as-octets (value)
  (etypecase value
    (string (trivial-utf-8:string-to-utf-8-bytes value))
    (vector
     (unless (every (lambda (byte) (typep byte '(unsigned-byte 8))) value)
       (bencode-fail "A byte string contains a non-octet"))
     (coerce value '(vector (unsigned-byte 8))))))

(defun byte-string< (left right)
  (let ((left (as-octets left)) (right (as-octets right)))
    (loop for index below (min (length left) (length right))
          for a = (aref left index) for b = (aref right index)
          when (< a b) return t
          when (> a b) return nil
          finally (return (< (length left) (length right))))))

(defun byte-string= (left right)
  (equalp (as-octets left) (as-octets right)))

(defun bencode-dictionary (entries)
  (let ((keys (mapcar #'car entries)))
    (loop for tail on keys
          when (find (first tail) (rest tail) :test #'byte-string=)
            do (bencode-fail "Duplicate dictionary key"))
    (%make-bencode-map entries)))

(defun bencode-value (dictionary key &optional default)
  (unless (bencode-map-p dictionary)
    (bencode-fail "Expected a bencoded dictionary"))
  (let ((entry (find key (bencode-map-entries dictionary)
                     :test #'byte-string= :key #'car)))
    (if entry (cdr entry) default)))

(defun push-octets (octets output)
  (loop for byte across octets do (vector-push-extend byte output)))

(defun encode-bencode (value)
  "Encode VALUE using canonical bencoding. Strings are encoded as UTF-8."
  (let ((output (make-array 128 :element-type '(unsigned-byte 8)
                                :adjustable t :fill-pointer 0)))
    (labels ((emit-ascii (text)
               (push-octets (trivial-utf-8:string-to-utf-8-bytes text) output))
             (emit-string (value)
               (let ((bytes (as-octets value)))
                 (emit-ascii (format nil "~D:" (length bytes)))
                 (push-octets bytes output)))
             (entries (dictionary)
               (typecase dictionary
                 (bencode-map (bencode-map-entries dictionary))
                 (hash-table
                  (loop for key being the hash-keys of dictionary using (hash-value item)
                        collect (cons key item)))))
             (emit (item)
               (typecase item
                 (integer (emit-ascii (format nil "i~De" item)))
                 ((or string vector) (emit-string item))
                 ((or bencode-map hash-table)
                  (vector-push-extend (char-code #\d) output)
                  (let ((sorted (stable-sort (copy-list (entries item))
                                             #'byte-string< :key #'car))
                        (previous nil))
                    (dolist (entry sorted)
                      (let ((key (as-octets (car entry))))
                        (when (and previous (equalp previous key))
                          (bencode-fail "Duplicate dictionary key"))
                        (emit-string key)
                        (emit (cdr entry))
                        (setf previous key))))
                  (vector-push-extend (char-code #\e) output))
                 (list
                  (vector-push-extend (char-code #\l) output)
                  (mapc #'emit item)
                  (vector-push-extend (char-code #\e) output))
                 (t (bencode-fail "Cannot encode ~S" item)))))
      (emit value)
      (copy-seq output))))

(defun decode-bencode (input)
  "Decode canonical bencoding, rejecting ambiguous and trailing input."
  (let ((input (as-octets input)) (position 0))
    (labels ((peek () (when (< position (length input)) (aref input position)))
             (number-until (terminator &key negative)
               (let ((start position))
                 (loop for byte = (peek) until (or (null byte) (= byte terminator))
                       do (unless (or (and negative (= position start)
                                           (= byte (char-code #\-)))
                                      (<= (char-code #\0) byte (char-code #\9)))
                            (bencode-fail "Invalid numeric token"))
                          (incf position))
                 (unless (peek) (bencode-fail "Unterminated numeric token"))
                 (let ((text (trivial-utf-8:utf-8-bytes-to-string
                              (subseq input start position))))
                   (incf position)
                   (when (or (zerop (length text))
                             (and (> (length text) 1) (char= #\0 (char text 0)))
                             (string= text "-0"))
                     (bencode-fail "Noncanonical numeric token"))
                   (handler-case (parse-integer text)
                     (error () (bencode-fail "Invalid numeric token"))))))
             (parse-string ()
               (let ((length (number-until (char-code #\:))))
                 (when (> (+ position length) (length input))
                   (bencode-fail "Byte string exceeds input"))
                 (prog1 (subseq input position (+ position length))
                   (incf position length))))
             (parse-value ()
               (let ((byte (peek)))
                 (cond
                   ((null byte) (bencode-fail "Unexpected end of input"))
                   ((= byte (char-code #\i))
                    (incf position)
                    (number-until (char-code #\e) :negative t))
                   ((= byte (char-code #\l))
                    (incf position)
                    (loop until (eql (peek) (char-code #\e))
                          collect (parse-value)
                          finally (incf position)))
                   ((= byte (char-code #\d))
                    (incf position)
                    (let ((items nil) (previous nil))
                      (loop until (eql (peek) (char-code #\e))
                            for key = (parse-string)
                            do (when (and previous (not (byte-string< previous key)))
                                 (bencode-fail "Dictionary keys are not strictly sorted"))
                               (push (cons key (parse-value)) items)
                               (setf previous key)
                            finally (incf position))
                      (%make-bencode-map (nreverse items))))
                   ((<= (char-code #\0) byte (char-code #\9)) (parse-string))
                   (t (bencode-fail "Invalid token ~D" byte))))))
      (let ((value (parse-value)))
        (unless (= position (length input))
          (bencode-fail "Trailing bytes after value"))
        value))))
